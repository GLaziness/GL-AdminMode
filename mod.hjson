#the mod name as displayed in-game
displayName: "GL Admin Mode"

#the internal name of your mod
name: "gl-admin-mode"

#your name
author: "GLaziness (based on SimpleAdminMode by FD)"

#the fully qualified main class of the mod
main: "fallen.SimpleAdminMode"

#the mod description as seen in the mod dialog
description: "Admin tools for tracking players and banning griefers, with a compact HUD panel under the left panels. Based on SimpleAdminMode."

#GitHub repository, used by the game and the mod to find updates
repo: "GLaziness/GL-AdminMode"

#the mod version
version: 2.6

#the minimum game build required to run this mod
minGameVersion: 155

#this is a java mod
java: true

hidden:true